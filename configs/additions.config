# 无论基础配置从哪来，这里的内容都会强制开启。

# ---- UPnP 功能 ----
# miniupnpd 是后台守护进程（nat 转发规则由它下发），必须在
CONFIG_PACKAGE_miniupnpd=y

# 界面包：你的改版顶替的正是上游这个同名包，所以名字仍然是 luci-app-upnp。
# 替换脚本会把 feeds 里的同名包链接删掉，这里打开的是你自己的那份。
CONFIG_PACKAGE_luci-app-upnp=y

# 如果你的仓库把包名写成了 luci-app-upnp-lease-time（而不是顶替原名），
# 这一行才会生效；包名不存在时 make defconfig 会自动忽略它，不用手动删。
CONFIG_PACKAGE_luci-app-upnp-lease-time=y
